---
import WidgetLayout from '../common/WidgetLayout.astro'

interface Props {
	class?: string
	style?: string
	title?: string
}

const className = Astro.props.class
const style = Astro.props.style
const title = Astro.props.title || '访问统计'

const UMAMI_SHARE_URL = 'https://cloud.umami.is/share/6jMN15DEsqo2zec9'
---

<WidgetLayout name={title} id="visitor-stats" class={className} style={style}>
	<div class="space-y-2 text-sm">
		<!-- 不蒜子统计 -->
		<div class="space-y-1.5">
			<div class="flex justify-between items-center text-neutral-600 dark:text-neutral-400">
				<span class="whitespace-nowrap">访问数</span>&nbsp;
				<span class="whitespace-nowrap">(今)</span>
				<span id="busuanzi_today_pv" class="font-medium text-neutral-900 dark:text-white"></span>
				<span>/</span>
				<span id="busuanzi_site_pv" class="font-medium text-neutral-900 dark:text-white"></span>
			</div>
			<div class="flex justify-between items-center text-neutral-600 dark:text-neutral-400">
				<span class="whitespace-nowrap">访客数 </span>&nbsp;
				<span class="whitespace-nowrap">(今)</span>
				<span id="busuanzi_today_uv" class="font-medium text-neutral-900 dark:text-white"></span>
				<span>/</span>
				<span id="busuanzi_site_uv" class="font-medium text-neutral-900 dark:text-white"></span>
			</div>
		</div>

		<div class="pt-2 border-t border-neutral-200 dark:border-neutral-700 mt-2">
			<a
				href={UMAMI_SHARE_URL}
				target="_blank"
				class="text-xs text-neutral-500 dark:text-neutral-400 hover:text-(--accent-color) dark:hover:text-white transition-colors flex items-center justify-end gap-1 group"
			>
				<span>查看详细统计</span>
				<svg class="w-3 h-3 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
				</svg>
			</a>
		</div>
	</div>
</WidgetLayout>

<!-- 加载不蒜子脚本 -->
<script is:inline src="//cdn.busuanzi.cc/busuanzi/3.6.9/busuanzi.abbr.min.js" defer></script>
